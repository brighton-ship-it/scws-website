# Copy values into GitHub Actions secrets or your local shell.
# Do not rename this to .env and commit it.

# Preferred: Jarvis Integration OAuth refresh flow
JOBBER_CLIENT_ID=
JOBBER_CLIENT_SECRET=
JOBBER_REFRESH_TOKEN=

# Or a short-lived bearer token
# JOBBER_ACCESS_TOKEN=

# Optional GraphQL version pin (default 2025-04-16)
# JOBBER_GRAPHQL_VERSION=2025-04-16
