{
  "redirects": [
    {
      "source": "/blog/well-pump-replacement.html",
      "destination": "/pages/services/pump-repair.html",
      "permanent": true
    },
    {
      "source": "/pages/services.html",
      "destination": "/pages/services/index.html",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.scwellservice.com"
        }
      ],
      "destination": "https://scwellservice.com/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
